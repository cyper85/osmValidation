{
  "name": "osmvalidation",
  "version": "1.0.0-alpha.0",
  "description": "JavaScript library to validate various value-types of OpenStreetMap.",
  "author": "Andreas Neumann <andr.neumann@googlemail.com>",
  "contributors": [
    "Andreas Neumann <andr.neumann@googlemail.com>"
  ],
  "scripts": {
    "test": "vitest run",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyper85/osmValidation.git"
  },
  "bugs": {
    "url": "https://github.com/cyper85/osmValidation/issues"
  },
  "keywords": [
    "OpenStreetMap",
    "Validation",
    "phone",
    "url",
    "email",
    "social network",
    "wikipedia",
    "wikidata"
  ],
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "homepage": "https://github.com/cyper85/osmValidation#readme",
  "dependencies": {
    "libphonenumber-js": "^1.13.15"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  }
}
